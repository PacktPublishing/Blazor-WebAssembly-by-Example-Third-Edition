@page "/expense-edit-editcontext"

@using Ch13_App.Models

<h2>Edit Expenses (EditContext)</h2>
This example uses an EditContext to manage the form state instead of binding directly to the model.
<hr /> 

<EditForm EditContext="editContext" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    Vendor <InputText @bind-Value="expense.Vendor" placeholder="Enter Vendor" />

    <button type="submit">Save</button>
</EditForm>

@code {
    private Expense expense = new();
    private Microsoft.AspNetCore.Components.Forms.EditContext? editContext;
 
    protected override void OnInitialized()
    {
        editContext = new(expense);
    }

    private void HandleValidSubmit()
    {
        // Handle the valid form submission here
    }
  
    private void HandleInvalidSubmit()
    {
        // Handle the invalid form submission here
    }
}

