@page "/login"

@using ClaimsDashboard.Client.Interfaces
@using ClaimsDashboard.Shared
@inject IAuthService AuthService
@inject NavigationManager Navigation

<h2>Login</h2>
<div style="max-width: 400px;">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="color: red; margin: 10px 0;">@errorMessage</div>
    }

    <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
        <div style="margin-bottom: 5px;">
            <label for="username">Username:</label>
            <InputText id="username" @bind-Value="loginRequest.UserName" />
        </div>
        <div style="margin-bottom: 15px;">
            <label for="password">Password:</label>
            <InputText id="password" @bind-Value="loginRequest.Password"
                       type="password" />
        </div>
        <button type="submit">Log in</button>
    </EditForm>
</div>

@code {
    private string? errorMessage;
    private LoginRequest loginRequest = new();

    private async Task HandleLogin()
    {
        errorMessage = null;

        var success = await AuthService.LoginAsync(loginRequest);
        if (success)
        {
            Navigation.NavigateTo("/claims");
        }
        else
        {
            errorMessage = "Invalid username or password";
        }
    }
}
